DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=
DISCORD_STATUS_CHANNEL_ID=
# Optional channel for UI-created and chat-created Task threads (digits only). Must differ from DISCORD_STATUS_CHANNEL_ID.
# DISCORD_TASK_CHANNEL_ID=
CHAT_PROVIDER=discord
AGENT_PROVIDER=codex
CLAUDE_MODEL=
# Claude only. Optional comma-separated Claude tool names that Turns and Task runs may use without a prompt, for example WebFetch,WebSearch.
# CLAUDE_ALLOWED_TOOLS=
# Claude only. Optional: 1h keeps Claude's prompt cache for 1 hour instead of 5 minutes in Turns and Task runs. Blank keeps the default.
# CLAUDE_PROMPT_CACHE_TTL=
# anthropic-api only. Required: an Anthropic Console API key, billed to its organization. Keep it only in this file.
# ANTHROPIC_API_KEY=
# anthropic-api only. Optional model ID. Blank uses claude-opus-5-5.
# ANTHROPIC_API_MODEL=
# anthropic-api only. Optional effort: low, medium, high, xhigh, or max. Blank uses the model's own default.
# ANTHROPIC_API_EFFORT=
# Optional stable Agent Instance identity; SQLite remains local to the runtime home.
AGENT_INSTANCE_ID=agent-inoai-planner
# Normal startup uses inoai.sqlite and ignores leftover POSTGRES_* settings.
# PostgreSQL settings are only for explicit advanced tools; see docs/postgres-local.md.
MEMORY_REVIEW_TIME=06:00
MEMORY_REVIEW_MAX_CHARS=20000
# Optional IANA time zone for Tasks created from Discord chat, for example Asia/Singapore. Blank uses the host time zone.
# OWNER_TIMEZONE=
